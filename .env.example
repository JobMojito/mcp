# ----------------------------------------------------------------------------
# JobMojito MCP — environment configuration
# Copy to `.env` for local dev. On Prefect Horizon, set these as deployment
# environment variables / secrets (never commit real secrets).
# ----------------------------------------------------------------------------

# --- JobMojito API (upstream) ------------------------------------------------
# Base URL the generated tools call. Defaults to the documented Edge Functions base.
JOBMOJITO_API_BASE_URL=https://cool.jobmojito.com/functions/v1

# Live OpenAPI spec URL fetched at startup (kept fresh automatically).
JOBMOJITO_OPENAPI_URL=https://cool.jobmojito.com/functions/v1/openapi

# Optional: Supabase anon key sent as the `apikey` header to Edge Functions.
# Many Supabase Edge Functions require this in addition to the user's Bearer JWT.
# Leave blank if your functions accept the user JWT alone.
SUPABASE_ANON_KEY=

# LOCAL DEV ONLY: a Supabase user access token to forward to the JobMojito API
# when there is no OAuth context (i.e. ENABLE_AUTH=false). Lets you exercise the
# API tools locally without the full login flow. NEVER set this in production.
JOBMOJITO_DEV_BEARER_TOKEN=

# --- Supabase OAuth (end-user auth at the MCP layer) -------------------------
# Supabase project URL. Provider derives all endpoints from this:
#   authorize: {url}/auth/v1/oauth/authorize
#   token:     {url}/auth/v1/oauth/token
#   jwks:      {url}/auth/v1/.well-known/jwks.json
#   oidc:      {url}/auth/v1/.well-known/openid-configuration
SUPABASE_PROJECT_URL=https://momsbvnltsydezmoesqt.supabase.co

# JWT signing algorithm of your Supabase OAuth tokens (ES256 or RS256).
# Supabase's newer asymmetric keys default to ES256.
SUPABASE_JWT_ALGORITHM=ES256

# Public base URL of THIS deployed MCP server (NO trailing /mcp, no trailing
# slash). This becomes the OAuth *resource identifier* published at
# /.well-known/oauth-protected-resource/mcp, and the MCP authorization spec
# requires it to equal the URL clients actually connect to, character for
# character. Get this wrong and discovery still returns 200 while every client
# fails token validation with 401 invalid_token.
#   Local:   http://localhost:8000
#   Horizon: https://mcp.jobmojito.com
# Verify after every deploy:
#   curl -s https://mcp.jobmojito.com/.well-known/oauth-protected-resource/mcp
#   # -> "resource" MUST be "https://mcp.jobmojito.com/mcp"
BASE_URL=http://localhost:8000

# --- Consent (handled by Supabase / the JobMojito app, NOT this server) ------
# The OAuth consent screen is served by Supabase at the Site URL below. This MCP
# server is only the OAuth resource server. These two values are informational
# (they document where consent lives) and must match your Supabase OAuth settings.
SITE_URL=https://app.jobmojito.com
OAUTH_CONSENT_PATH=/oauth/consent

# Set to "false" to run the server WITHOUT Supabase auth (local testing only).
ENABLE_AUTH=true

# Path the MCP endpoint is served on. Combined with BASE_URL to form the OAuth
# resource identifier. Leave as /mcp unless you have a specific reason.
MCP_PATH=/mcp

# Scopes advertised in the protected-resource metadata and in the `scope=`
# parameter of the 401 WWW-Authenticate challenge, so clients request the right
# ones up front instead of guessing. Comma-separated.
#
# KEEP `offline_access`. It is what makes Supabase issue a refresh token, which
# is the difference between a silent token refresh every hour and a full browser
# re-authorization every hour. Supabase advertises it (check with:
# curl -s $SUPABASE_PROJECT_URL/auth/v1/.well-known/oauth-authorization-server).
OAUTH_SCOPES_SUPPORTED=openid,email,offline_access

# Lazy authentication (default: on). Serves `initialize` and `tools/list`
# WITHOUT a token; every tool call, resource read and prompt still requires a
# verified Supabase JWT. This is what lets directory crawlers (Smithery, Glama)
# display the tool list — a fully gated server shows up with zero tools, which
# is the main quality signal a browsing user sees. Set to false to require a
# token for absolutely everything.
ENABLE_LAZY_AUTH=true

# Verify the Supabase *session* behind each JWT, not just its signature and exp
# (default: on). The JobMojito Edge Functions resolve the JWT to a live session;
# a plain JWT check does not, so without this the server accepts tokens the API
# rejects — and because a tool error is an HTTP 200, the client never learns it
# must re-authenticate. Costs one cached GET /auth/v1/user per token per TTL.
# Requires SUPABASE_ANON_KEY. Fails OPEN if Supabase Auth is unreachable.
SUPABASE_SESSION_CHECK=true
# Seconds a successful session check is trusted — i.e. the worst-case delay
# between a user signing out and this server noticing. Never exceeds the token's
# own expiry. Raise to cut auth traffic, lower to react faster.
SUPABASE_SESSION_CHECK_TTL=60

# --- Directory listings ------------------------------------------------------
# OpenAI plugin-directory domain verification. When set, the token is served
# verbatim at /.well-known/openai-apps-challenge; when blank that route 404s.
# Get the value from the OpenAI plugin submission portal.
OPENAI_APPS_CHALLENGE_TOKEN=

# Reverse-DNS name published to the official MCP Registry (see server.json).
REGISTRY_SERVER_NAME=com.jobmojito/jobmojito

# Public URLs surfaced in the server card and required by directory submissions.
MARKETING_SITE_URL=https://jobmojito.com
DOCUMENTATION_URL=https://developer.jobmojito.com/mcp
PRIVACY_POLICY_URL=https://jobmojito.com/privacy_policy
SUPPORT_URL=https://help.jobmojito.com

# Server logo. OpenAI requires square, 48-4096px, <=5 MiB, and the extension must
# match the real format. The server logs a warning if this is still a .ico.
SERVER_ICON_URL=https://jobmojito.com/favicon.png
SERVER_ICON_MIME=image/png
# Optional size hint(s), e.g. "512x512". Left blank on purpose: advertising the
# wrong dimensions is worse than advertising none, because clients use the hint
# to choose between icon variants. Fill in once you have confirmed the real size.
SERVER_ICON_SIZES=

# --- Result guards -----------------------------------------------------------
# Maximum characters in a single tool result. Claude truncates around 150,000
# chars on Claude.ai/Desktop (25,000 tokens in Claude Code), so we refuse a
# little below that with an actionable "use limit/offset" error rather than
# letting the client silently cut the response in half. 0 disables the check.
MAX_TOOL_RESULT_CHARS=120000

# --- Documentation sources (single-source; read live) ------------------------
# Developer docs expose an llms.txt index + per-page .md (used by search/get tools).
DEVELOPER_DOCS_LLMS_URL=https://developer.jobmojito.com/llms.txt
DEVELOPER_DOCS_BASE_URL=https://developer.jobmojito.com

# Featurebase help center base URL (recruiter/candidate/admin docs).
HELP_DOCS_BASE_URL=https://help.jobmojito.com

# --- Help center via Featurebase REST API (preferred when key is set) --------
# help.jobmojito.com runs on Featurebase. With an API key, the help docs tools
# use the official REST API (structured articles incl. body) instead of HTML
# scraping.
# Create a key in the Featurebase dashboard: log in (https://auth.featurebase.app/choose-org)
# -> Settings -> Advanced -> API -> copy the key.
# NOTE: Featurebase uses a single API KEY (sent as Authorization: Bearer <key>
# and/or X-API-Key) — NOT a client id/secret. Its MCP uses interactive OAuth+PKCE
# (no secret). So a "Client ID + Client secret" pair is not a Featurebase docs credential.
FEATUREBASE_API_KEY=
FEATUREBASE_API_BASE_URL=https://do.featurebase.app
FEATUREBASE_API_VERSION=2026-01-01.nova

# --- Developer docs via Mintlify MCP (federated into this server) ------------
# developer.jobmojito.com is a Mintlify site. Its MCP (semantic search +
# docs-filesystem) is mounted here so those tools are exposed through this one
# connector. Federation is ON by default using the PUBLIC endpoint below — no
# credentials needed, since the developer docs are public.
DEVELOPER_DOCS_MCP_URL=https://developer.jobmojito.com/mcp

# To use the AUTHENTICATED endpoint instead (group-restricted content):
#   1) In the Mintlify dashboard (MCP server page) click "Enable MCP Server".
#      Until enabled, /authed/mcp and its OAuth token endpoint return 404.
#   2) Create a client credential there (Mintlify *MCP client credentials*, NOT
#      Mintlify API keys) and set the two values below.
#   3) Point the URL above at: https://developer.jobmojito.com/authed/mcp
# Auth is attached only when the URL contains "/authed" AND both values are set.
DEVELOPER_DOCS_MCP_CLIENT_ID=
DEVELOPER_DOCS_MCP_CLIENT_SECRET=
# Optional token-endpoint override; defaults to <DEVELOPER_DOCS_MCP_URL>/oauth/token
DEVELOPER_DOCS_MCP_TOKEN_URL=

# Optional: hosted Featurebase Reader MCP (read-only, includes help center). It
# uses interactive OAuth (no client secret) — best added directly in the AI tool
# rather than proxied here. Kept for reference; not used by code.
HELP_DOCS_MCP_URL=https://mcp-read.featurebase.app/

# Minutes to cache documentation indexes/pages before refetching.
DOCS_CACHE_TTL_MINUTES=60
